diff --git a/web/build.sh b/web/build.sh
new file mode 100755
index 00000000..fb983ae3
--- /dev/null
+++ b/web/build.sh
@@ -0,0 +1,64 @@
+#!/usr/bin/env bash
+set -euo pipefail
+ROOT="$(cd "$(dirname "$0")/.." && pwd)"
+SDL3_ROOT="${SDL3_ROOT:-$ROOT/web/deps/sdl3}"
+ZLIB_ROOT="${ZLIB_ROOT:-$ROOT/web/deps/zlib}"
+OUT="${OUT:-$ROOT/web/dist}"
+OBJ="${OBJ_DIR:-$ROOT/web/obj}"
+JOBS="${JOBS:-$(nproc 2>/dev/null || echo 4)}"
+mkdir -p "$OUT" "$OBJ"
+
+DEFS=(
+  -DRELEASE=1
+  -DCRS_APP_DRIVER_SDL=1
+  -DCRS_VIDEO_DRIVER_SDL_GENERIC=1
+  -DCRS_VIDEO_DRIVER_WEBGL=1
+  -DCRS_INPUT_DRIVER_SDL=1
+  -DSOUND_ENABLED=1
+)
+CFLAGS=(
+  -O2 ${CFLAGS_EXTRA:-} -std=gnu11 -fno-strict-aliasing
+  -Wno-pointer-to-int-cast -Wno-deprecated-non-prototype -Wno-tautological-overlap-compare
+  -Wno-c2x-extensions -Wno-c23-extensions -Wno-incompatible-pointer-types -Wno-int-conversion
+  -Wno-unused-variable -Wno-unused-function -Wno-unused-but-set-variable
+  -I"$ROOT/src" -I"$ROOT/src/sdk" -I"$SDL3_ROOT/include" -I"$ZLIB_ROOT/include"
+)
+
+mapfile -t SRCS < <(cd "$ROOT" && find src -name '*.c' \
+  -not -path 'src/imgui/*' \
+  -not -path 'src/platform/netplay/*' \
+  -not -path 'src/platform/video/opengl/*' \
+  -not -path 'src/platform/video/sdl_gpu/*' \
+  -not -path 'src/platform/video/psp/*' \
+  -not -path 'src/platform/app/psp/*' \
+  -not -path 'src/platform/input/statcheck/*' \
+  -not -path 'src/test/*' | sort)
+
+compile() {
+  local src="$1"
+  local obj="$OBJ/${src//\//_}.o"
+  if [ ! -f "$obj" ] || [ "$ROOT/$src" -nt "$obj" ]; then
+    emcc "${CFLAGS[@]}" "${DEFS[@]}" -c "$ROOT/$src" -o "$obj" || { echo "FAILED: $src"; return 1; }
+  fi
+  echo "$obj"
+}
+export -f compile
+export ROOT OBJ
+export CFLAGS_STR="${CFLAGS[*]}" DEFS_STR="${DEFS[*]}"
+
+printf '%s\n' "${SRCS[@]}" | xargs -P "$JOBS" -I{} bash -c 'src="{}"; obj="$OBJ/${src//\//_}.o"; if [ ! -f "$obj" ] || [ "$ROOT/$src" -nt "$obj" ]; then emcc $CFLAGS_STR $DEFS_STR -c "$ROOT/$src" -o "$obj" 2>>"$OBJ/errors.log" || echo "FAILED: $src"; fi'
+
+OBJS=()
+for src in "${SRCS[@]}"; do OBJS+=("$OBJ/${src//\//_}.o"); done
+
+emcc -O2 ${LINK_EXTRA:-} "${OBJS[@]}" ${EXTRA_OBJS:-} "$SDL3_ROOT/lib/libSDL3.a" "$ZLIB_ROOT/lib/libz.a" \
+  -sMAX_WEBGL_VERSION=2 -sMIN_WEBGL_VERSION=2 \
+  -sEMULATE_FUNCTION_POINTER_CASTS=1 \
+  -sALLOW_MEMORY_GROWTH=1 -sINITIAL_MEMORY=134217728 -sSTACK_SIZE=4194304 \
+  -sFORCE_FILESYSTEM=1 -sEXIT_RUNTIME=0 -sINVOKE_RUN=0 \
+  -sMODULARIZE=1 -sEXPORT_NAME=create3SX -sENVIRONMENT=web \
+  -sEXPORTED_RUNTIME_METHODS=FS,IDBFS,callMain,addRunDependency,removeRunDependency -lidbfs.js \
+  --preload-file "$ROOT/assets@/assets" \
+  -o "$OUT/3sx.js"
+cp "$ROOT"/web/shell/* "$OUT"/
+echo "built $OUT/3sx.js"
diff --git a/web/shell/index.html b/web/shell/index.html
new file mode 100644
index 00000000..84f24e84
--- /dev/null
+++ b/web/shell/index.html
@@ -0,0 +1,57 @@
+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>3SX Web</title>
+<link rel="preconnect" href="https://fonts.googleapis.com">
+<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
+<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;700&display=swap" rel="stylesheet">
+<link rel="stylesheet" href="shell.css">
+</head>
+<body>
+<canvas id="canvas" tabindex="-1" oncontextmenu="event.preventDefault()"></canvas>
+
+<main id="launcher">
+  <h1>3SX <span>WEB</span></h1>
+  <p class="tag">Street Fighter III: 3rd Strike, running natively in your browser.</p>
+
+  <section class="card" id="need-file">
+    <h2>Insert your disc data</h2>
+    <p>3SX needs <code>SF33RD.AFS</code> from your own PS2 copy of <em>3rd Strike</em> or
+      <em>Street Fighter Anniversary Collection</em> (it's in the <code>THIRD</code> folder on the disc).
+      The file never leaves your computer. It's stored in this browser so you only pick it once.</p>
+    <label class="btn" id="pick-label">
+      <input type="file" id="pick" accept=".afs,.AFS">
+      CHOOSE SF33RD.AFS
+    </label>
+    <p class="hint">or drag and drop it anywhere on this page</p>
+  </section>
+
+  <section class="card" id="ready" hidden>
+    <h2>Ready</h2>
+    <p id="ready-text">Your disc data is loaded.</p>
+    <button class="btn" id="play">FIGHT!</button>
+    <button class="link" id="forget">use a different file</button>
+  </section>
+
+  <section class="card" id="busy" hidden>
+    <h2 id="busy-title">Loading</h2>
+    <progress id="bar" max="1" value="0"></progress>
+    <p id="busy-text"></p>
+  </section>
+
+  <p class="error" id="error" hidden></p>
+
+  <footer>
+    <p><b>Controls:</b> keyboard and gamepads work. F11 or Alt+Enter toggles fullscreen. Default keys: arrows or WASD move, U I J K and O P L ; are the attack buttons, Enter is Start.
+      Keys and pads can be remapped in the game's config.</p>
+    <p>3SX by <a href="https://github.com/crowded-street/3sx" target="_blank" rel="noopener">Crowded Street</a> (GPLv3),
+      compiled to WebAssembly. Street Fighter III: 3rd Strike &copy; Capcom. No game data is included on this page.</p>
+  </footer>
+</main>
+
+
+<script src="loader.js"></script>
+</body>
+</html>
diff --git a/web/shell/loader.js b/web/shell/loader.js
new file mode 100644
index 00000000..30632a9c
--- /dev/null
+++ b/web/shell/loader.js
@@ -0,0 +1,231 @@
+(() => {
+  const EXPECTED_SHA = 'f9fa50f3a124ec9fa9465aa9c8546c2d867887eb39f711a070762a0324ba5604';
+  const EXPECTED_SIZE = 642492416;
+  const DB_NAME = '3sx-web';
+  const STORE = 'files';
+  const KEY = 'SF33RD.AFS';
+  const PREF = '/libsdl/CrowdedStreet/3SX';
+
+  const $ = id => document.getElementById(id);
+  const show = (id, on) => { $(id).hidden = !on; };
+  let afsBlob = null;
+  let started = false;
+
+  function setError(msg) {
+    $('error').textContent = msg || '';
+    show('error', !!msg);
+  }
+
+  function busy(title, text, value) {
+    show('need-file', false);
+    show('ready', false);
+    show('busy', true);
+    $('busy-title').textContent = title;
+    $('busy-text').textContent = text || '';
+    if (value === undefined) $('bar').removeAttribute('value');
+    else $('bar').value = value;
+  }
+
+  function openDb() {
+    return new Promise((resolve, reject) => {
+      const req = indexedDB.open(DB_NAME, 1);
+      req.onupgradeneeded = () => req.result.createObjectStore(STORE);
+      req.onsuccess = () => resolve(req.result);
+      req.onerror = () => reject(req.error);
+    });
+  }
+
+  async function dbGet() {
+    try {
+      const db = await openDb();
+      return await new Promise((resolve, reject) => {
+        const req = db.transaction(STORE).objectStore(STORE).get(KEY);
+        req.onsuccess = () => resolve(req.result || null);
+        req.onerror = () => reject(req.error);
+      });
+    } catch (e) {
+      return null;
+    }
+  }
+
+  async function dbPut(blob) {
+    try {
+      const db = await openDb();
+      await new Promise((resolve, reject) => {
+        const tx = db.transaction(STORE, 'readwrite');
+        tx.objectStore(STORE).put(blob, KEY);
+        tx.oncomplete = resolve;
+        tx.onerror = () => reject(tx.error);
+      });
+    } catch (e) {
+      console.warn('Could not cache AFS in IndexedDB', e);
+    }
+  }
+
+  async function dbDelete() {
+    try {
+      const db = await openDb();
+      db.transaction(STORE, 'readwrite').objectStore(STORE).delete(KEY);
+    } catch (e) {}
+  }
+
+  const hex = buf => [...new Uint8Array(buf)].map(b => b.toString(16).padStart(2, '0')).join('');
+
+  async function verify(blob) {
+    if (blob.size !== EXPECTED_SIZE) {
+      throw new Error(`That file is ${blob.size.toLocaleString()} bytes, but SF33RD.AFS should be ${EXPECTED_SIZE.toLocaleString()} bytes. Make sure you picked THIRD/SF33RD.AFS from the PS2 disc.`);
+    }
+    if (!(window.crypto && crypto.subtle)) return;
+    busy('Checking file', 'Verifying checksum...');
+    const digest = hex(await crypto.subtle.digest('SHA-256', await blob.arrayBuffer()));
+    if (digest !== EXPECTED_SHA) {
+      throw new Error('Checksum mismatch: this is not the SF33RD.AFS 3SX expects (it must come from the PS2 release).');
+    }
+  }
+
+  async function accept(blob, fromUser) {
+    setError('');
+    try {
+      await verify(blob);
+      afsBlob = blob;
+      if (fromUser) {
+        busy('Saving', 'Storing the file in this browser so you only have to pick it once...');
+        await dbPut(blob);
+      }
+      showReady();
+    } catch (e) {
+      afsBlob = null;
+      setError(e.message);
+      showPicker();
+    }
+  }
+
+  function showPicker() {
+    show('busy', false);
+    show('ready', false);
+    show('need-file', true);
+  }
+
+  function showReady() {
+    show('busy', false);
+    show('need-file', false);
+    show('ready', true);
+    $('play').focus();
+  }
+
+  function syncFs(FS, populate) {
+    return new Promise(resolve => FS.syncfs(populate, err => {
+      if (err) console.warn('IDBFS sync failed', err);
+      resolve();
+    }));
+  }
+
+  async function start() {
+    if (started || !afsBlob) return;
+    started = true;
+    busy('Loading', 'Reading disc data into memory...');
+    const data = new Uint8Array(await afsBlob.arrayBuffer());
+    busy('Loading', 'Starting the game...');
+
+    const canvas = $('canvas');
+    document.body.classList.add('playing');
+
+    const moduleConfig = {
+      canvas,
+      noInitialRun: true,
+      print: t => console.log(t),
+      printErr: t => console.warn(t),
+      locateFile: f => f,
+      preRun: [
+        mod => {
+          const FS = mod.FS;
+          FS.mkdir('/libsdl');
+          FS.mount(mod.IDBFS, {}, '/libsdl');
+          mod.addRunDependency('idbfs');
+          FS.syncfs(true, err => {
+            if (err) console.warn('IDBFS load failed', err);
+            mod.removeRunDependency('idbfs');
+          });
+          FS.mkdir('/afs');
+          FS.writeFile('/afs/SF33RD.AFS', data, { canOwn: true });
+        },
+      ],
+    };
+
+    const mod = await create3SX(moduleConfig);
+    const FS = mod.FS;
+    const mkdirp = p => {
+      let cur = '';
+      for (const part of p.split('/').filter(Boolean)) {
+        cur += '/' + part;
+        try { FS.mkdir(cur); } catch (e) {}
+      }
+    };
+    mkdirp(PREF);
+    await syncFs(FS, false);
+
+    setInterval(() => syncFs(FS, false), 5000);
+    window.addEventListener('pagehide', () => syncFs(FS, false));
+    document.addEventListener('visibilitychange', () => { if (document.hidden) syncFs(FS, false); });
+    window.__3sx = mod;
+
+    try {
+      mod.callMain([]);
+    } catch (e) {
+      if (e && e.name !== 'ExitStatus' && e !== 'unwind') throw e;
+    }
+    canvas.focus();
+  }
+
+  $('pick').addEventListener('change', e => {
+    const f = e.target.files && e.target.files[0];
+    if (f) accept(f, true);
+  });
+  $('play').addEventListener('click', start);
+  $('forget').addEventListener('click', async () => {
+    await dbDelete();
+    afsBlob = null;
+    showPicker();
+  });
+
+  window.addEventListener('dragover', e => { e.preventDefault(); document.body.classList.add('dragging'); });
+  window.addEventListener('dragleave', () => document.body.classList.remove('dragging'));
+  window.addEventListener('drop', e => {
+    e.preventDefault();
+    document.body.classList.remove('dragging');
+    const f = e.dataTransfer.files && e.dataTransfer.files[0];
+    if (f && !started) accept(f, true);
+  });
+  window.addEventListener('keydown', e => {
+    if (!started && e.key === 'Enter' && !$('ready').hidden) start();
+  });
+
+  async function init() {
+    const script = document.createElement('script');
+    script.src = '3sx.js';
+    document.head.appendChild(script);
+
+    busy('Loading', 'Looking for your disc data...');
+    const cached = await dbGet();
+    if (cached) {
+      afsBlob = cached;
+      $('ready-text').textContent = 'Using the SF33RD.AFS saved in this browser.';
+      showReady();
+      return;
+    }
+    try {
+      const head = await fetch('SF33RD.AFS', { method: 'HEAD' });
+      if (head.ok && +head.headers.get('content-length') === EXPECTED_SIZE) {
+        busy('Loading', 'Found SF33RD.AFS next to the game, reading it...');
+        const blob = await (await fetch('SF33RD.AFS')).blob();
+        afsBlob = blob;
+        $('ready-text').textContent = 'Using SF33RD.AFS from the game folder.';
+        showReady();
+        return;
+      }
+    } catch (e) {}
+    showPicker();
+  }
+
+  init();
+})();
diff --git a/web/shell/shell.css b/web/shell/shell.css
new file mode 100644
index 00000000..0184026f
--- /dev/null
+++ b/web/shell/shell.css
@@ -0,0 +1,141 @@
+:root {
+  --bg: #120a16;
+  --card: #1f1326;
+  --ink: #fff6e8;
+  --dim: #b8a8c0;
+  --red: #ff3b30;
+  --gold: #ffc53d;
+  --outline: #07030a;
+}
+
+* { box-sizing: border-box; }
+
+html, body {
+  margin: 0;
+  min-height: 100%;
+  background: radial-gradient(ellipse at top, #3a1030 0%, var(--bg) 60%);
+  color: var(--ink);
+  font-family: "Fredoka", system-ui, sans-serif;
+}
+
+#canvas {
+  display: none;
+  position: fixed;
+  inset: 0;
+  width: 100vw;
+  height: 100vh;
+  background: #000;
+  outline: none;
+}
+
+body.playing #canvas { display: block; }
+body.playing #launcher { display: none; }
+body.playing { background: #000; overflow: hidden; }
+
+#launcher {
+  max-width: 640px;
+  margin: 0 auto;
+  padding: 40px 18px 30px;
+  display: flex;
+  flex-direction: column;
+  gap: 18px;
+}
+
+h1 {
+  margin: 0;
+  font-size: clamp(56px, 16vw, 110px);
+  font-weight: 700;
+  line-height: 0.9;
+  letter-spacing: 0.02em;
+  color: var(--gold);
+  -webkit-text-stroke: 5px var(--outline);
+  paint-order: stroke fill;
+  text-shadow: 6px 6px 0 var(--red);
+}
+
+h1 span { color: var(--ink); }
+
+.tag { margin: 0; color: var(--dim); font-size: 18px; }
+
+.card {
+  background: var(--card);
+  border: 4px solid var(--outline);
+  border-radius: 18px;
+  box-shadow: 6px 6px 0 var(--outline);
+  padding: 18px 20px 20px;
+}
+
+.card[hidden] { display: none; }
+
+h2 { margin: 0 0 8px; font-size: 26px; }
+
+.card p { margin: 0 0 14px; line-height: 1.45; color: var(--dim); }
+
+code { color: var(--gold); font-weight: 700; }
+
+.btn {
+  display: inline-block;
+  font: 700 22px "Fredoka", system-ui, sans-serif;
+  letter-spacing: 0.04em;
+  color: var(--outline);
+  background: var(--gold);
+  border: 4px solid var(--outline);
+  border-radius: 14px;
+  box-shadow: 4px 4px 0 var(--outline);
+  padding: 12px 26px;
+  cursor: pointer;
+  transition: transform 0.06s, box-shadow 0.06s;
+}
+
+.btn:hover { background: #ffd66e; }
+.btn:active { transform: translate(3px, 3px); box-shadow: 1px 1px 0 var(--outline); }
+.btn input { display: none; }
+
+#play { background: var(--red); color: var(--ink); font-size: 30px; padding: 12px 40px; }
+#play:hover { background: #ff5a51; }
+
+.link {
+  background: none;
+  border: none;
+  color: var(--dim);
+  font: 500 15px "Fredoka", sans-serif;
+  text-decoration: underline;
+  cursor: pointer;
+  margin-left: 14px;
+}
+
+.hint { margin: 10px 0 0 !important; font-size: 14px; }
+
+progress { width: 100%; height: 16px; accent-color: var(--gold); }
+
+.error {
+  margin: 0;
+  background: #4a0d12;
+  border: 3px solid var(--red);
+  border-radius: 12px;
+  padding: 12px 14px;
+}
+
+footer { color: var(--dim); font-size: 13px; line-height: 1.5; }
+footer p { margin: 0 0 6px; }
+a { color: var(--gold); }
+
+body.dragging #launcher { outline: 4px dashed var(--gold); outline-offset: -8px; border-radius: 18px; }
+
+.fs {
+  position: fixed;
+  right: 12px;
+  bottom: 12px;
+  z-index: 10;
+  width: 44px;
+  height: 44px;
+  font-size: 22px;
+  border-radius: 12px;
+  border: 3px solid var(--outline);
+  background: rgba(255, 197, 61, 0.85);
+  cursor: pointer;
+  opacity: 0.35;
+  transition: opacity 0.2s;
+}
+
+.fs:hover { opacity: 1; }
